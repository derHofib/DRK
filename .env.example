# Migrations laufen mit diesem (privilegierten) Rollen-User.
MIGRATIONS_DATABASE_URL=postgresql://zimmerakte_admin:dev_only_change_me@localhost:5432/zimmerakte

# Die API verbindet sich NIE als Admin, sondern als eingeschraenkte Rolle ohne
# BYPASSRLS. Das ist die Rolle, die RLS tatsaechlich durchsetzt (siehe
# migrations/0002_app_role.sql).
APP_DATABASE_URL=postgresql://zimmerakte_app:dev_only_change_me_too@localhost:5432/zimmerakte

# Nur fuer lokale Entwicklung. In jeder echten Umgebung aus einem
# Secret-Store beziehen, nie im Repo.
JWT_SECRET=dev_only_change_me_in_production

PORT=3000
NODE_ENV=development
